<!-- Job -->
<div class="modal fade" id="job" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title" id="job-title">Job</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="job-body">
	<div class="mb-2">
		<label class="form-label" for="job-name">Name (Optional)</label>
		<input type='text' class='form-control form-control-sm' id='job-name'/>
	</div>
	<div class="mb-2">
		<label class="form-label" for="job-command">Command</label>
		<textarea class='form-control form-control-sm' id='job-command' rows='2' oninput="job_command = $(this).val(); job_string();"></textarea>
	</div>
	<label class="form-label">Quick Schedule</label>
	<div class="row g-2 mb-1">
		<div class="col"><a class="btn btn-outline-primary btn-sm w-100" onclick="schedule = '* * * * *'; job_string();">Every Minute</a></div>
		<div class="col"><a class="btn btn-outline-primary btn-sm w-100" onclick="schedule = '@hourly'; job_string();">Hourly</a></div>
		<div class="col"><a class="btn btn-outline-primary btn-sm w-100" onclick="schedule = '@daily'; job_string();">Daily</a></div>
		<div class="col"><a class="btn btn-outline-primary btn-sm w-100" onclick="schedule = '@monthly'; job_string();">Monthly</a></div>
		<div class="col"><a class="btn btn-outline-primary btn-sm w-100" onclick="schedule = '@weekly'; job_string();">Weekly</a></div>
		<div class="col-auto d-flex gap-1">
			<a class="btn btn-outline-primary btn-sm" onclick="schedule = '@yearly'; job_string();">Yearly</a>
			<a class="btn btn-outline-primary btn-sm" onclick="schedule = '@reboot'; job_string();">Startup</a>
		</div>
	</div>

	<div class="row g-2 align-items-end mb-2">
		<div class="col"><label class="form-label small mb-1">Minute</label><input type="text" class="form-control form-control-sm" id="job-minute" value="*" onclick="this.select();"/></div>
		<div class="col"><label class="form-label small mb-1">Hour</label><input type="text" class="form-control form-control-sm" id="job-hour" value="*" onclick="this.select();"/></div>
		<div class="col"><label class="form-label small mb-1">Day</label><input type="text" class="form-control form-control-sm" id="job-day" value="*" onclick="this.select();"/></div>
		<div class="col"><label class="form-label small mb-1">Month</label><input type="text" class="form-control form-control-sm" id="job-month" value="*" onclick="this.select();"/></div>
		<div class="col"><label class="form-label small mb-1">Week</label><input type="text" class="form-control form-control-sm" id="job-week" value="*" onclick="this.select();"/></div>
		<div class="col-auto"><a class="btn btn-primary btn-sm" onclick="set_schedule();">Set</a></div>
	</div>

	<div class="mb-2">
		<label class="form-label" for="job-string">Job</label>
		<input type='text' class='form-control form-control-sm' id='job-string' disabled='disabled'/>
	</div>
	<div class="d-flex flex-wrap align-items-center gap-3">
		<div class="form-check m-0">
			<input type="checkbox" class="form-check-input" id="job-logging"/>
			<label class="form-check-label" for="job-logging">Enable error logging</label>
		</div>
		<a class="btn btn-outline-secondary btn-sm" data-json="{}" onclick="setMailConfig(this);" id="job-mailing"><i class="bi bi-envelope"></i> Mailing</a>
		<a class="btn btn-outline-secondary btn-sm" data-json="{}" onclick="setHookConfig(this);"><i class="bi bi-hdd-network"></i> Hooks</a>
	</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="job-save">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-title">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="modal-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="modal-close-button">Close</button>
        <button type="button" class="btn btn-primary" id="modal-button">Ok</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="info-popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="info-title">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="info-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="info-button">Ok</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="preview-crontab-modal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-code-square"></i> Crontab Preview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3"><i class="bi bi-exclamation-triangle"></i> This is a preview of what will be deployed. It may differ from the currently active crontab if you have unsaved changes.</div>
        <pre id="preview-crontab-content" class="bg-dark text-light p-3 rounded" style="min-height:200px;white-space:pre-wrap;word-break:break-all;font-size:0.875rem;"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="copyCrontab()"><i class="bi bi-clipboard"></i> Copy</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
